{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "features/editor/ui/main/ui/editor-view.tsx",
    "features/editor/ui/main/ui/diff.tsx",
    "features/editor/ui/main/hooks/use-monaco-workers.ts",
    "features/editor/ui/main/hooks/use-emmet.ts",
    "features/editor/ui/main/hooks/use-eslint.ts",
    "features/editor/ui/main/hooks/use-design-diagnostics.ts",
    "features/editor/lsp/**",
    "features/editor/ui/layout.tsx",
    "features/explorer/**",
    "features/activity-bar/**",
    "lib/editor/suppress-monaco-native-ui.ts",
    "lib/editor/register-monaco-languages.ts"
  ]
}
