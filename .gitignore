# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
src-tauri/target/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Shape
.shape/

# Local agent guidance (not published)
AGENTS.md
COMMIT.md

# Updater signing private key (never commit)
src-tauri/.updater-keys/shape.key
src-tauri/.updater-keys/*.key
!src-tauri/.updater-keys/*.key.pub
