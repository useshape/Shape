# Dev Cloud URL. Release builds ignore this and use https://www.useshape.org.
NEXT_PUBLIC_SHAPE_WEBSITE_URL=http://localhost:3000

# Read by the Rust build (src-tauri/build.rs) for Cloud AI attestation.
# Release CI sets the same value as the website SHAPE_CLOUD_BUILD_SECRET.
# SHAPE_CLOUD_BUILD_SECRET=

# Same Sentry project as the website. source=desktop is set in the client.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SHAPE_RELEASE=""
